{
  "name": "game-app-workspace",
  "version": "1.0.0",
  "description": "Fullstack Game App Monorepo (Node.js/Express + React/Tailwind + MongoDB)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
